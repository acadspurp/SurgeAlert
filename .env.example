# Shared environment template for local dev and hosting
# Copy this file to ".env" and replace placeholders with real values.

# --- Core backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/surgealert_db?useSSL=false&serverTimezone=Asia/Manila&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
SURGE_ENCRYPTION_SECRET=replace_with_16_plus_char_secret

# --- SMTP / email ---
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# --- External APIs ---
WORLDTIDES_API_KEY=your_worldtides_key
SEMAPHORE_ENABLED=false
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
SEMAPHORE_SENDER_NAME=SurgeAlert

# --- MQTT ---
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_BROKER_USERNAME=your_mqtt_username
MQTT_BROKER_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=surgealert-backend
MQTT_TOPIC_SENSOR=sensor/data
MQTT_USE_SSL=false

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=file:/absolute/path/to/firebase-service-account.json

# --- Edge system ---
BACKEND_IP=127.0.0.1
BACKEND_PORT=8080
EDGE_API_KEY=replace_with_same_app_edge_api_key
MQTT_BROKER=localhost
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
SMS_ONLINE_PRIMARY=true

# --- Frontend (non-secret, safe for browser bundle) ---
VITE_API_BASE_URL=http://localhost:8080/api
